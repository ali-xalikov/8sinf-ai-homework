# ============================================================
#  "8-sinf AI Homework" — sozlamalar (SERVER tomonda)
#  Bu faylni loyiha ildizida ".env" deb saqlang.
#  Bu fayl faqat serverda — frontendga yuborilmaydi.
# ============================================================

# ---------- Server / Tarmoq ----------
# 0.0.0.0 -> shu kompyuterdagi Wi-Fi/LAN tarmog'ining barcha qurilmalariga ochiq
HOST=0.0.0.0
PORT=3000

# Frontend'ning publika URL'i (ulashish havolasi va /s/{token} redirect uchun).
# Vercel'da frontend bo'lsa — o'sha domen: https://8sinf-ai.vercel.app
# Bo'sh -> so'rov kelgan backend manzili ishlatiladi.
PUBLIC_BASE_URL=

# CORS uchun ruxsat berilgan origin'lar (vergul bilan ajrating).
# Bo'sh -> faqat bir xil origin (xavfsiz default).
# Prodda frontend domenini yozing: https://8sinf-ai.vercel.app
# Barcha origin'lar kerak bo'lsa: *
ALLOWED_ORIGINS=
# Ixtiyoriy: origin'larni regex bilan (masalan Vercel preview domenlari uchun):
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# ---------- Ma'lumotlar bazasi ----------
# Bo'sh -> SQLite (index/library.db). Prod uchun PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# ---------- AI (LLM) ----------
# auto | openai | ollama | none
LLM_PROVIDER=auto

# OpenAI / OpenAI-compatible server (server tomonida saqlanadi, frontendga chiqmaydi)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Mahalliy Ollama (hammaga bitta markaziy server yetarli)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- AI navbati / chegara ----------
MAX_CONCURRENT_AI_REQUESTS=3
MAX_AI_REQUESTS_PER_MINUTE=10
AI_REQUEST_TIMEOUT_S=240

# ---------- Admin (birinchi ishga tushirishda) ----------
ADMIN_USERNAME=admin
# Bo'sh bo'lsa — tasodifiy parol generatsiya qilinadi va konsolga chiqariladi.
# PRODDA MAJBURIY: kuchli parolni hosting "Environment Variables" orqali bering
# (checkmark: bu qiymatni hech qachon git'ga yoki .env faylga saqlamang).
ADMIN_PASSWORD=

# ---------- Sessiya ----------
SESSION_DAYS=30

# ---------- OCR ----------
# Skan PDF uchun Tesseract: https://github.com/UB-Mannheim/tesseract/wiki
OCR_ENABLED=true
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# ---------- Indekslash ----------
MIN_TEXT_CHARS_PER_PAGE=40
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_PAGE_TEXT_FOR_LLM=5000
RENDER_DPI=150